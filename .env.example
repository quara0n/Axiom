# Backend only. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
OPENROUTER_API_KEY=
# Where the dashboard saves the key from LLM settings. Kept outside .env so
# `next dev` does not reload the page mid-save. A key set in the real environment
# or in .env always wins over this file.
AXIOM_CREDENTIALS=.axiom/credentials.env
AXIOM_MODEL=openrouter/free
AXIOM_BACKEND_URL=http://127.0.0.1:8000
# Relative paths resolve against the directory from which you start the backend.
AXIOM_WORKSPACE_ROOT=.axiom/workspaces
AXIOM_DATABASE=.axiom/tasks.sqlite3
# Wall-clock limit for one whole task, including subagents and repair rounds.
# A real multi-file build with delegation needs more than 10 minutes.
AXIOM_TASK_TIMEOUT=1800
# Rounds per agent that change the project (write_file, edit_file, delegation).
# Reading and validating files does not count towards this; inspection is instead
# bounded by AXIOM_MAX_MODEL_CALLS. Max 200.
AXIOM_MAX_TOOL_ROUNDS=60
# Additional Coder -> checks -> Tester -> Reviewer passes. 0 disables repair.
AXIOM_MAX_REPAIR_ROUNDS=2
# Isolated Coder subagents: concurrent workers per delegation call (max 3) and
# total subagents per task (max 12).
AXIOM_MAX_WORKERS=3
AXIOM_MAX_SUBAGENTS_PER_TASK=6
# Shared across all agents and all repair rounds in one task.
AXIOM_MAX_MODEL_CALLS=240
# Output budget per model call. Reasoning models spend part of it thinking, and a
# long plan or report needs the rest. Max 200000.
AXIOM_MAX_TOKENS=32768
# Planner/Tester/Reviewer ceiling, additionally bounded by AXIOM_MAX_TOKENS.
# Coder keeps the full output budget. A single truncation recovery uses <=4096.
AXIOM_REPORT_MAX_TOKENS=8192
# How much the model may spend thinking before it has to answer. Unbounded
# reasoning makes a reasoning model burn the whole output budget and act on nothing.
AXIOM_REASONING_MAX_TOKENS=2048
AXIOM_REQUEST_TIMEOUT=180
# JEV (TypeSafe System One) answers typed questions with probabilities instead of
# prose, so the harness can ask narrow questions about the finished project. It is a
# second provider with its own key and endpoint and it is optional: with no key
# nothing is sent and no JEV field appears in the record. The evidence pass sends the
# requirements the task states itself plus the files the run wrote, and records one
# yes/no judgement per requirement in verification.jev_evidence for the Tester and
# Reviewer. It can never approve a task or override a failed check, and only a
# confident "no" is reported as a finding - a probability near 0.5 means the model
# did not know, not that it disagreed. Costs roughly $0.0004 per task.
TYPESAFE_API_KEY=
AXIOM_JEV_BASE_URL=https://api.typesafe.ai/v1
AXIOM_JEV_MODEL=jev-1.13.0
AXIOM_JEV_EVIDENCE=1
AXIOM_JEV_REQUEST_TIMEOUT=60
AXIOM_JEV_MAX_ATTEMPTS=3
# Serve the page a finished run wrote, so it can be opened in a browser. The page is
# generated code running in your browser on this machine, not a sandbox, so it is off
# until you ask for it. It listens on its own loopback port, which keeps it on a
# different origin from this API.
AXIOM_ALLOW_PREVIEW=0
AXIOM_PREVIEW_PORT=8100
# Model Context Protocol servers the Coder may use. Each entry is a command the
# backend spawns and talks to over stdio, so this is opt-in: a server is someone
# else's code running with the backend's privileges, and it is started only when an
# agent reaches for one of its tools. Tools arrive in the agent's list prefixed with
# the server name, so blender__make_cube can never collide with a workspace tool.
#
# Blender, for example (needs the Blender MCP addon running inside Blender, and uvx):
#   AXIOM_MCP_SERVERS=[{"name":"blender","command":"uvx","args":["blender-mcp"]}]
AXIOM_ALLOW_MCP=0
AXIOM_MCP_SERVERS=
AXIOM_MCP_TIMEOUT=120
